// RUN: frisk-opt %s -o /dev/null
// CPU coverage regression: unmaterialized final store endpoint needs a Shared repair.
module attributes {
  frisk.test_assignments = {
    "9:transport/b1/o1/r0/storage" = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>,
    "9:transport/b1/o10/r0/distributed" = #frisk.distributed<map = #frisk.bit_linear<inputs = ["register", "lane", "warp"], input_bits = [5, 5, 2], outputs = ["dim0", "dim1"], output_bits = [6, 6], matrix = dense<"0x024000080001000480200004800010001200"> : tensor<12x12xi1>>, topology = [32, 32, 4, 1, 1], replication = 1>,
    "9:transport/b1/o11/r0/distributed" = #frisk.distributed<map = #frisk.bit_linear<inputs = ["register", "lane", "warp"], input_bits = [5, 5, 2], outputs = ["dim0", "dim1"], output_bits = [6, 6], matrix = dense<"0x001200024000080001000480200004800010"> : tensor<12x12xi1>>, topology = [32, 32, 4, 1, 1], replication = 1>,
    "9:transport/b1/o12/r0/distributed" = #frisk.distributed<map = #frisk.bit_linear<inputs = ["register", "lane", "warp"], input_bits = [5, 5, 2], outputs = ["dim0", "dim1"], output_bits = [6, 6], matrix = dense<"0x001200024000080001000480200004800010"> : tensor<12x12xi1>>, topology = [32, 32, 4, 1, 1], replication = 1>,
    "9:transport/b1/o13/r0/distributed" = #frisk.distributed<map = #frisk.bit_linear<inputs = ["register", "lane", "warp"], input_bits = [5, 5, 2], outputs = ["dim0", "dim1"], output_bits = [6, 6], matrix = dense<"0x001200024000080001000480200004800010"> : tensor<12x12xi1>>, topology = [32, 32, 4, 1, 1], replication = 1>,
    "9:transport/b1/o14/r0/distributed" = #frisk.distributed<map = #frisk.bit_linear<inputs = ["register", "lane", "warp"], input_bits = [5, 5, 2], outputs = ["dim0", "dim1"], output_bits = [6, 6], matrix = dense<"0x001200024000080001000480200004800010"> : tensor<12x12xi1>>, topology = [32, 32, 4, 1, 1], replication = 1>,
    "9:transport/b1/o15/r0/distributed" = #frisk.distributed<map = #frisk.bit_linear<inputs = ["register", "lane", "warp"], input_bits = [5, 5, 2], outputs = ["dim0", "dim1"], output_bits = [6, 6], matrix = dense<"0x001200024000080001000480200004800010"> : tensor<12x12xi1>>, topology = [32, 32, 4, 1, 1], replication = 1>,
    "9:transport/b1/o16/use0" = #frisk.distributed<map = #frisk.bit_linear<inputs = ["register", "lane", "warp"], input_bits = [5, 5, 2], outputs = ["dim0", "dim1"], output_bits = [6, 6], matrix = dense<"0x024000080001000480200004800010001200"> : tensor<12x12xi1>>, topology = [32, 32, 4, 1, 1], replication = 1>,
    "9:transport/b1/o3/r0/storage" = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>,
    "9:transport/b1/o5/r0/storage" = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>,
    "9:transport/b1/o7/r0/storage" = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>,
    "9:transport/b1/o8/r0/distributed" = #frisk.distributed<map = #frisk.bit_linear<inputs = ["register", "lane", "warp"], input_bits = [5, 5, 2], outputs = ["dim0", "dim1"], output_bits = [6, 6], matrix = dense<"0x024000080001000480200004800010001200"> : tensor<12x12xi1>>, topology = [32, 32, 4, 1, 1], replication = 1>,
    "9:transport/b1/o9/r0/distributed" = #frisk.distributed<map = #frisk.bit_linear<inputs = ["register", "lane", "warp"], input_bits = [5, 5, 2], outputs = ["dim0", "dim1"], output_bits = [6, 6], matrix = dense<"0x024000080001000480200004800010001200"> : tensor<12x12xi1>>, topology = [32, 32, 4, 1, 1], replication = 1>
  },frisk.execution_domain = "sm90-scalar-f32-dag-v1", frisk.target = "sm_90a"} {
  frisk.kernel @transport(memref<64x64xf32, 1>, memref<64x64xf32, 1>, memref<64x64xf32, 1>, memref<64x64xf32, 1>) {
  ^bb0(%arg0: memref<64x64xf32, 1>, %arg1: memref<64x64xf32, 1>, %arg2: memref<64x64xf32, 1>, %arg3: memref<64x64xf32, 1>):
    frisk.storage_contract %arg0 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1>
    frisk.storage_contract %arg1 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1>
    frisk.storage_contract %arg2 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1>
    frisk.storage_contract %arg3 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1>
    frisk.parallel (%arg4) = (1), threads = 128 {
      frisk.storage_contract %arg0 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1>
      %0 = frisk.layout_view %arg0 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1> -> memref<64x64xf32, 1>
      frisk.storage_contract %arg3 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1>
      %1 = frisk.layout_view %arg3 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1> -> memref<64x64xf32, 1>
      frisk.storage_contract %arg1 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1>
      %2 = frisk.layout_view %arg1 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1> -> memref<64x64xf32, 1>
      frisk.storage_contract %arg2 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1>
      %3 = frisk.layout_view %arg2 {layout = #frisk.storage<map = #frisk.affine_layout<inputs = ["dim0", "dim1"], input_extents = [64, 64], outputs = ["byte_offset", "bit_offset"], output_extents = [16384, 8], map = affine_map<(d0, d1) -> ((d0 * 64 + d1) * 4, 0)>>, memory_space = #frisk<memory_space Global>, alignment = 1, vector_granularity = 1>} : memref<64x64xf32, 1> -> memref<64x64xf32, 1>
      %4 = frisk.tile_load %0 : memref<64x64xf32, 1> -> tensor<64x64xf32>
      %5 = frisk.tile_load %2 : memref<64x64xf32, 1> -> tensor<64x64xf32>
      %6 = frisk.tile_load %3 : memref<64x64xf32, 1> -> tensor<64x64xf32>
      %7 = arith.mulf %4, %4 : tensor<64x64xf32>
      %8 = arith.mulf %7, %7 : tensor<64x64xf32>
      %9 = arith.mulf %7, %7 : tensor<64x64xf32>
      %10 = arith.mulf %9, %6 : tensor<64x64xf32>
      %11 = arith.subf %8, %10 : tensor<64x64xf32>
      frisk.tile_store %11, %1 : tensor<64x64xf32>, memref<64x64xf32, 1>
      frisk.end
    }
    frisk.end
  }
}